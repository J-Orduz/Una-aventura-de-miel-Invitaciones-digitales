# URL base del backend (Cloudflare Worker).
# Local: http://127.0.0.1:8787  ·  Producción: https://tu-worker.tu-subdominio.workers.dev
# Si se deja vacío, el frontend funciona en modo simulado con datos de prueba.
VITE_API_BASE_URL=

# Credenciales públicas de Supabase (Project Settings → API).
# La llave "anon" es pública; la service_role NUNCA va en el frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
